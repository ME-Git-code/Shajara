// ============================================
// SHAJARA — Prisma Schema (MVP v1)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTH / USER
// ============================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  avatarUrl     String?
  googleId      String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Bir user bir nechta shajaraga a'zo bo'lishi mumkin (Ota tarafi / Ona tarafi)
  memberships   TreeMember[]

  // Bu user qaysi Person profiliga "o'zi" sifatida bog'langan (har bir tree uchun alohida)
  personLinks   Person[]     @relation("PersonOwner")

  sentMessages     Message[]     @relation("MessageSender")
  notifications    Notification[]

  @@index([email])
}

// ============================================
// TREE (Multi-Tree Architecture)
// ============================================

model Tree {
  id            String   @id @default(uuid())
  name          String   // masalan: "Rustamovlar shajarasi (Ota tarafi)"
  createdAt     DateTime @default(now())
  ownerId       String   // birinchi yaratgan user

  // Limitlar (progressiv, keyin config orqali o'zgaradi)
  photoLimit    Int      @default(5)
  storageLimitMb Int     @default(50)
  storageUsedMb  Float   @default(0)
  plan          Plan     @default(FREE)

  members       TreeMember[]
  persons       Person[]
  relationships Relationship[]
  media         Media[]

  @@index([ownerId])
}

enum Plan {
  FREE
  PRO
}

// User <-> Tree bog'lanishi (bir nechta tree'ga a'zo bo'lish uchun)
model TreeMember {
  id        String   @id @default(uuid())
  userId    String
  treeId    String
  role      TreeRole @default(MEMBER)
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tree      Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@unique([userId, treeId])
  @@index([treeId])
}

enum TreeRole {
  OWNER   // shajara yaratuvchisi
  ADMIN   // tahrirlash huquqi kengroq
  MEMBER  // faqat o'z profilini boshqaradi
}

// ============================================
// PERSON (Shajaradagi har bir shaxs)
// ============================================

model Person {
  id            String    @id @default(uuid())
  treeId        String
  tree          Tree      @relation(fields: [treeId], references: [id], onDelete: Cascade)

  // Agar bu shaxs tizimda ro'yxatdan o'tgan bo'lsa (o'zi yoki uni qo'shgan qarindosh tasdiqlagan)
  linkedUserId  String?
  linkedUser    User?     @relation("PersonOwner", fields: [linkedUserId], references: [id])

  firstName     String
  lastName      String
  fatherName    String?   // Otasining ismi
  gender        Gender
  birthDate     DateTime?
  deathDate     DateTime?
  isAlive       Boolean   @default(true)
  phone         String?
  bio           String?   @db.Text
  photoUrl      String?

  // Kim tomonidan kiritilgan (audit uchun asosiy)
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Tasdiqlash holati (boshqa odam kiritsa, tasdiq kutadi)
  status        PersonStatus @default(PENDING)

  // Joylashuv (xarita moduli uchun, keyingi bosqich)
  birthPlace    String?
  livesIn       String?

  relationshipsAsA Relationship[] @relation("PersonA")
  relationshipsAsB Relationship[] @relation("PersonB")
  media            Media[]
  fieldHistory     FieldHistory[]

  @@index([treeId])
  @@index([linkedUserId])
}

enum Gender {
  MALE
  FEMALE
}

enum PersonStatus {
  PENDING    // boshqa odam kiritgan, hali tasdiqlanmagan
  CONFIRMED  // o'zi yoki egasi tasdiqlagan
}

// ============================================
// RELATIONSHIP (Graf: node=Person, edge=Relationship)
// Kinship Engine shu jadval ustida ishlaydi
// ============================================

model Relationship {
  id          String           @id @default(uuid())
  treeId      String
  tree        Tree             @relation(fields: [treeId], references: [id], onDelete: Cascade)

  personAId   String
  personA     Person           @relation("PersonA", fields: [personAId], references: [id], onDelete: Cascade)

  personBId   String
  personB     Person           @relation("PersonB", fields: [personBId], references: [id], onDelete: Cascade)

  // PARENT_CHILD: A -> B (A otasi/onasi, B farzandi)
  // SPOUSE: A <-> B (turmush o'rtoqlar, yo'nalishsiz)
  type        RelationType

  createdAt   DateTime         @default(now())

  @@unique([personAId, personBId, type])
  @@index([treeId])
  @@index([personAId])
  @@index([personBId])
}

enum RelationType {
  PARENT_CHILD
  SPOUSE
}

// ============================================
// AUDIT LOG (har bir maydon tarixi)
// ============================================

model FieldHistory {
  id          String   @id @default(uuid())
  personId    String
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)

  fieldName   String   // masalan: "firstName", "birthDate"
  oldValue    String?
  newValue    String?

  changedById String   // qaysi user o'zgartirgan
  changedAt   DateTime @default(now())

  @@index([personId])
}

// ============================================
// MEDIA (Foto/Video/Audio arxiv)
// ============================================

model Media {
  id          String    @id @default(uuid())
  treeId      String
  tree        Tree      @relation(fields: [treeId], references: [id], onDelete: Cascade)

  personId    String?
  person      Person?   @relation(fields: [personId], references: [id])

  type        MediaType
  url         String    // Cloudflare R2 URL
  sizeMb      Float
  caption     String?

  uploadedById String
  createdAt    DateTime @default(now())

  @@index([treeId])
  @@index([personId])
}

enum MediaType {
  PHOTO
  VIDEO
  AUDIO
}

// ============================================
// MESSENGER (keyingi bosqich uchun tayyor)
// ============================================

model Message {
  id          String   @id @default(uuid())
  treeId      String
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
  receiverId  String
  content     String   @db.Text
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([treeId])
  @@index([senderId, receiverId])
}

// ============================================
// NOTIFICATIONS (tasdiqlash so'rovlari va h.k.)
// ============================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum NotificationType {
  PERSON_ADDED_YOU
  MERGE_SUGGESTED
  RELATIVE_INVITE
}
